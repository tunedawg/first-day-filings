# ─── Google OAuth (for Google Drive document generation) ─────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For local dev:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
# For production (Railway):
# GOOGLE_OAUTH_REDIRECT_URI=https://first-day-filings.up.railway.app/auth/google/callback

# ─── Gemini AI (for petition extraction) ─────────────────────────────────────
# Get at aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from Supabase dashboard → Project Settings → API
# NOTE: All three must be added to Railway → Variables before deploying.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key bypasses RLS — server-side only, never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
