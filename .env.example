# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Box OAuth
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=https://your-domain.up.railway.app/oauth/box/callback
# After first admin auth, these get stored in DB and auto-refreshed:
# BOX_ACCESS_TOKEN=
# BOX_REFRESH_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.up.railway.app/oauth/google/callback
# After first auth, stored in DB and auto-refreshed:
# GOOGLE_ACCESS_TOKEN=
# GOOGLE_REFRESH_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# App
SECRET_KEY=change-me-to-random-string
FLASK_ENV=production
